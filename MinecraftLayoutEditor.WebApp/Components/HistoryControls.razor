<div class="history-controls">
    <button type="button" class="btn" @onclick="Clear" disabled="@(!CanClear)">
        Clear layout
    </button>

    <button type="button" class="btn" @onclick="Undo" disabled="@(!CanUndo)">
        Undo
    </button>

    <button type="button" class="btn" @onclick="Redo" disabled="@(!CanRedo)">
        Redo
    </button>
</div>
