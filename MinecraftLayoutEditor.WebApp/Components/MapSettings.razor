@using MinecraftLayoutEditor.Logic
@using static MinecraftLayoutEditor.Logic.Map

<h3>Layout Settings</h3>

<div class="layout-settings">
    <div class="form-group">
        <label for="name">Name</label>
        <input type="text" id="name" class="form-control" @bind="Name" @bind:after="OnNameChanged" />
    </div>
    <div class="row">
        <div class="form-group">
            <label>Width</label>
            <div class="stepper">
                <span class="stepper-value">@Width</span>
                <button type="button" class="btn stepper-btn" @onclick="() => AdjustWidth(-16)" disabled="@(Width <= 32)">−</button>
                <button type="button" class="btn stepper-btn" @onclick="() => AdjustWidth(16)">+</button>
            </div>
        </div>
        <div class="form-group">
            <label>Height</label>
            <div class="stepper">
                <span class="stepper-value">@Height</span>
                <button type="button" class="btn stepper-btn" @onclick="() => AdjustHeight(-16)" disabled="@(Height <= 32)">−</button>
                <button type="button" class="btn stepper-btn" @onclick="() => AdjustHeight(16)">+</button>
            </div>
        </div>
    </div>
    <div class="form-group">
        <label for="laneWidth">Lane Width</label>
        <input type="number" id="laneWidth" class="form-control" @bind="LaneWidth" @bind:after="OnLaneWidthChanged" min="2" max="16"/>
    </div>
    <div class="form-group">
        <label for="thickness">Thickness</label>
        <input type="number" id="thickness" class="form-control" @bind="Thickness" @bind:after="OnThicknessChanged" min="2" max="16" />
    </div>
    <div class="form-group">
        <label for="selectedNodeType">Node type</label>
        <select id="selectedNodeType" class="form-control"
                @bind="SelectedNodeType" @bind:after="OnSelectedNodeTypeChanged">
            <option value="@Node.NodeType.Undefined">Undefined</option>
            <option value="@Node.NodeType.Wool">Wool</option>
            <option value="@Node.NodeType.Spawn">Spawn</option>
        </select>
    </div>
</div>