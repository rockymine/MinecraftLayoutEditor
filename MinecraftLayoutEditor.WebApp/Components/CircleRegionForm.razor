<div class="settings-group">
    <div class="form-group">
        <label for="name">Name</label>
        <input type="text"
               name="name" 
               class="form-control"
               @bind="CircleRegion.Id"
               @bind:after="OnNameChanged" />
    </div>
    <div class="row">
        <div class="form-group">
            <label for="minX">X</label>
            <input name="minX"
                   type="number"
                   step="1"
                   value="@CircleRegion.Center.X"
                   @onfocus="() => HandleFocus()"
                   @onchange="e => UpdateCenterX(CircleRegion, e)" />
        </div>
        <div class="form-group">
            <label for="minY">Y</label>
            <input name="minY" type="number"
                   step="1"
                   value="@CircleRegion.Center.Y"
                   @onfocus="() => HandleFocus()"
                   @onchange="e => UpdateCenterY(CircleRegion, e)" />
        </div>
    </div>
    <div class="form-group">
        <label for="radius">Radius</label>
        <input name="radius" type="number"
               step="1"
               min="1"
               value="@CircleRegion.Radius"
               @onfocus="() => HandleFocus()"
               @onchange="e => UpdateRadius(CircleRegion, e)" />
    </div>
    <button type="button"
            class="btn btn-full"
            @onclick="DeleteRegion">
        Delete
    </button>
</div>