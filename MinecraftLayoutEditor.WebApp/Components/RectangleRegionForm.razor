<div class="region-card">
    <div class="card-header">
        <span class="region-type">Rect</span>
        <input type="text"
               class="id-input"
               @bind="RectangleRegion.Id"
               @bind:after="OnNameChanged" />
        <button type="button"
                class="btn-delete"
                @onclick="DeleteRegion">
            <svg class="icon" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
        </button>
    </div>
    <div class="input-grid">
        <div class="row-2">
            <div class="input-group">
                <label class="input-label">Min X</label>
                <input type="number"
                       class="coord-input"
                       step="1"
                       value="@RectangleRegion.Min.X"
                       @onfocus="() => HandleFocus()"
                       @onchange="e => UpdateMinX(RectangleRegion, e)" />
            </div>
            <div class="input-group">
                <label class="input-label">Min Y</label>
                <input type="number"
                       class="coord-input"
                       step="1"
                       value="@RectangleRegion.Min.Y"
                       @onfocus="() => HandleFocus()"
                       @onchange="e => UpdateMinY(RectangleRegion, e)" />
            </div>
        </div>
        <div class="row-2">
            <div class="input-group">
                <label class="input-label">Max X</label>
                <input type="number"
                       class="coord-input"
                       step="1"
                       value="@RectangleRegion.Max.X"
                       @onfocus="() => HandleFocus()"
                       @onchange="e => UpdateMaxX(RectangleRegion, e)" />
            </div>
            <div class="input-group">
                <label class="input-label">Max Y</label>
                <input type="number"
                       class="coord-input"
                       step="1"
                       value="@RectangleRegion.Max.Y"
                       @onfocus="() => HandleFocus()"
                       @onchange="e => UpdateMaxY(RectangleRegion, e)" />
            </div>
        </div>
    </div>
</div>
