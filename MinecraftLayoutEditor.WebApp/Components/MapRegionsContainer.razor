@using MinecraftLayoutEditor.XML
@using System.Numerics
<h3>MapRegionsContainer</h3>

@if (RegionsElement != null && RegionsElement.Items.Count == 0)
{
    <span>Create a Region</span>
}
else if (RegionsElement != null)
{
    @for (int i = 0; i < RegionsElement.Items.Count; i++)
    {
        var index = i;
        var region = RegionsElement.Items[index];

        <div>
            @if (region is RectangleRegion rectangle)
            {
                <RectangleRegionForm RectangleRegion="rectangle"
                                     RectangleRegionChanged="updated => RegionsElement.Items[index] = updated"
                                     SettingsChanged="OnRegionSettingsChanged"
                                     OnRegionFocused="region => SetHoveredRegion(region)"
                                     OnDelete="() => DeleteRegionAt(index)" />
            }

            @if (region is CircleRegion circle)
            {
                <CircleRegionForm CircleRegion="circle"
                    CircleRegionChanged="updated => RegionsElement.Items[index] = updated"
                    SettingsChanged="OnRegionSettingsChanged"
                    OnRegionFocused="region => SetHoveredRegion(region)"
                    OnDelete="() => DeleteRegionAt(index)" />
            }
        </div>
    }
}

