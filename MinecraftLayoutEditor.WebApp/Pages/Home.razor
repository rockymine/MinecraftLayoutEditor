@page "/"
@using MinecraftLayoutEditor.WebApp.Components
@using SkiaSharp.Views.Blazor
@using MinecraftLayoutEditor.Logic

<PageTitle>Minecraft Layout Editor</PageTitle>

<header>
    <h1>Minecraft Layout Editor</h1>
</header>

<div class="layout">
    <div class="sidebar">
        <EditingModeSwitch EditorMode="_currentMode"
            OnChangeMode="OnChangeEditingMode" />

        @if (_currentMode == EditorMode.Layout)
        {
            <MapSettings @bind-Name="_map.Name"
            @bind-Width="_map.Width"
            @bind-Height="_map.Height"
            @bind-LaneWidth="_map.LaneWidth"
            @bind-Thickness="_map.Thickness"
            @bind-SelectedNodeType="_map.SelectedNodeType"
            SettingsChanged="OnSettingsChanged" />
            <button type="button" class="btn btn-primary" @onclick="OnSchematicCreate" disabled="@(!_map.Graph.Nodes.Any())">
                Generate Schematic
            </button>
            <MirrorControls @bind-MirrorEnabled="_map.MirrorEnabled"
            @bind-RotationDeg="_map.Symmetry.RotationDeg"
            @bind-IsHorizontal="_map.Symmetry.IsHorizontal"
            SettingsChanged="OnSettingsChanged" />

            <VisualizationControls @bind-ShowBlocksEnabled="_renderingOptions.ShowBlocksEnabled"
            @bind-ShowBoundingBoxEnabled="_renderingOptions.ShowBoundingBoxEnabled"
            SettingsChanged="OnSettingsChanged" />
            <!-- Node information -->
            <NodeInformation SelectedNode="_renderContext.SelectedNode"
            OnDeleteNode="OnDeleteNode" />
            <!-- Canvas controls -->
            <CanvasControlsHelp />
            <div class="form-group">
                <label>Import World (Region Files + level.dat)</label>
                <InputFile OnChange="LoadWorldFiles" multiple accept=".mca,.dat,.xml" />
            </div>
        }

        @if(_currentMode == EditorMode.XML)
        {
            <RegionTypeSwitch @bind-RegionType="_renderContext.SelectedRegionType"/>
            @if(_renderContext.MapElement != null)
            {
                <MapRegionsContainer @bind-RegionsElement="_renderContext.MapElement.Regions"
                SettingsChanged="OnSettingsChanged" RegionFocused="OnRegionFocused"/>
            }
        }
    </div>

    <div class="editor">
        <div class="editor-toolbar">
            <!-- History controls -->
            <HistoryControls CanUndo="@(_historyStack?.CanUndo ?? false)"
                             CanRedo="@(_historyStack?.CanRedo ?? false)"
                             CanClear="@(_map.Graph.Nodes.Any())"
                             OnClearMap="OnClearMap"
                             OnUndo="OnUndo"
                             OnRedo="OnRedo" />
            <!-- View controls -->
            <ViewControls MirrorEnabled="@(_map.MirrorEnabled)"
                          OnFitMap="OnFitMap"
                          OnFitTeam="OnFitTeam" />
        </div>
        <!-- Canvas -->
        <div id="canvasContainer"
             @ref="@(_canvasContainer)"
             style="cursor: @(CursorClass)"
             @onmouseup="OnMouseUp"
             @onmousemove="OnMouseMove"
             @oncontextmenu:preventDefault=true
             @onkeyup="OnKeyUp"
             tabindex="0"
             @onmousedown="OnMouseDown"
             @onkeyup:preventDefault=true
             @onkeydown:preventDefault=true
             @onmousedown:preventDefault=true>
            <SKGLView @ref="_canvas"
                      OnPaintSurface="OnPaintSurface"
                      Width="@CanvasWidth"
                      Height="@CanvasHeight"
                      IgnorePixelScaling="true">
            </SKGLView>
        </div>
    </div>
</div>

<footer>
    <p>&copy; 2025 Michael Ganske.</p>
    <p><a href="https://github.com/rockymine/MinecraftLayoutEditor">View on GitHub</a></p>
</footer>