@page "/"
@using MinecraftLayoutEditor.WebApp.Components
@using SkiaSharp.Views.Blazor

<PageTitle>Minecraft Layout Editor</PageTitle>

<header>
    <h1>Minecraft Layout Editor</h1>
</header>

<div class="layout">
    <div class="sidebar">
        <LayoutSettings @bind-Name="_layout.Name"
                        @bind-Width="_layout.Width"
                        @bind-Height="_layout.Height"
                        @bind-LaneWidth="_layout.LaneWidth"
                        @bind-Thickness="_layout.Thickness"
                        @bind-SelectedNodeType="_layout.SelectedNodeType"
                        SettingsChanged="OnSettingsChanged" />
        <button type="button" class="btn btn-primary" @onclick="OnSchematicCreate" disabled="@(!_layout.Graph.Nodes.Any())">
            Generate Schematic
        </button>
        <MirrorControls @bind-MirrorEnabled="_layout.MirrorEnabled"
                        @bind-RotationDeg="_layout.Symmetry.RotationDeg"
                        @bind-IsHorizontal="_layout.Symmetry.IsHorizontal"
                        SettingsChanged="OnSettingsChanged" />

        <VisualizationControls @bind-ShowBlocksEnabled="_renderingOptions.ShowBlocksEnabled"
                               @bind-ShowBoundingBoxEnabled="_renderingOptions.ShowBoundingBoxEnabled"
                               SettingsChanged="OnSettingsChanged" />
        <!-- Node information -->
        <NodeInformation SelectedNode="SelectedNode"
                         OnDeleteNode="OnDeleteNode" />
        <!-- Canvas controls -->
        <CanvasControlsHelp />
        <div class="form-group">
            <label>Import World (Region Files + level.dat)</label>
            <InputFile OnChange="LoadWorldFiles" multiple accept=".mca,.dat" />
        </div>
    </div>

    <div class="editor">
        <div class="editor-toolbar">
            <!-- History controls -->
            <HistoryControls CanUndo="@(_historyStack?.CanUndo ?? false)"
                             CanRedo="@(_historyStack?.CanRedo ?? false)"
                             CanClear="@(_layout.Graph.Nodes.Any())"
                             OnClearLayout="OnClearLayout"
                             OnUndo="OnUndo"
                             OnRedo="OnRedo" />
            <!-- View controls -->
            <ViewControls MirrorEnabled="@(_layout.MirrorEnabled)"
                          OnResetView="OnResetView"
                          OnFitLayout="OnFitLayout"
                          OnFitTeam="OnFitTeam" />
        </div>
        <!-- Canvas -->
        <div id="canvasContainer"
             @ref="@(_canvasContainer)"
             style="cursor: @(CursorClass)"
             @onmouseup="OnMouseUp"
             @onmousemove="OnMouseMove"
             @oncontextmenu:preventDefault=true
             @onkeyup="OnKeyUp"
             tabindex="0"
             @onmousedown="OnMouseDown"
             @onkeyup:preventDefault=true
             @onkeydown:preventDefault=true
             @onmousedown:preventDefault=true>
            <SKGLView @ref="Canvas"
                      OnPaintSurface="OnPaintSurface"
                      Width="@CanvasWidth"
                      Height="@CanvasHeight"
                      IgnorePixelScaling="true">
            </SKGLView>
        </div>
    </div>
</div>

<footer>
    <p>&copy; 2025 Michael Ganske.</p>
    <p><a href="https://github.com/rockymine/MinecraftLayoutEditor">View on GitHub</a></p>
</footer>